# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

# In-Memory Storage
MAX_HISTORY_PER_SENSOR=1000

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# External Java Spring Boot Sensor Simulator
# Configure according to the simulator's host/port when deployed
SENSOR_SIMULATOR_URL=http://localhost:8081
SENSOR_SIMULATOR_WS_URL=ws://localhost:8081/ws/sensors
SENSOR_SIMULATOR_TIMEOUT_SECONDS=5.0
